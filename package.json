{
  "name": "gas-fee-optimizer",
  "version": "2.0.0",
  "type": "module",
  "description": "Measure what a Pharos transaction should pay: base fee history, observed tip behaviour, and the cost of overpaying or over-locking.",
  "bin": {
    "gas-fee": "bin/gas-fee.mjs"
  },
  "scripts": {
    "test": "node test/unit.test.mjs && node test/api.test.mjs",
    "test:live": "node test/live.test.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "dev": "wrangler pages dev public --compatibility-date=2026-01-01",
    "advise": "node bin/gas-fee.mjs advise"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "src",
    "bin",
    "scripts",
    "functions",
    "public",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "author": "Namri",
  "publishConfig": {
    "access": "public"
  }
}
